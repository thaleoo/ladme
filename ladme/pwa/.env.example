# Copie este archivo como .env.local y complete con los datos del proyecto Supabase.
# Nunca suba .env.local al repositorio.
VITE_SUPABASE_URL="https://SUPROYECTO.supabase.co"
# Clave pública del cliente. En proyectos nuevos es la "Publishable key" (sb_publishable_...).
# En proyectos con claves legacy es la "anon public" (eyJ...). Nunca la secret/service_role.
VITE_SUPABASE_ANON_KEY="sb_publishable_..."
# URL pública del sitio (se usa en enlaces de correo y en la credencial)
VITE_PUBLIC_URL="https://ladme.example.edu.co"
# Clave pública VAPID para Web Push (se genera una sola vez; la privada vive en la Edge Function)
VITE_VAPID_PUBLIC_KEY=""
